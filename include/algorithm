// <algorithm> - the few that are reached for.
//
// **Everything here is a template over iterators, and an iterator in this
// library is a pointer.** `vector<T>::iterator` is `T *` and a map's is a
// `pair<K, V> *`, so these work on arrays and on this library's containers
// alike, which is the property that makes them worth having as templates rather
// than as members.
//
// What is not here: `sort`, `find_if`, and the rest of the header. They are
// absent because nothing calls them, and adding them untested would be adding
// the appearance of a library rather than a library.
#ifndef _CXX1_ALGORITHM
#define _CXX1_ALGORITHM

#include <cstddef>

namespace std {

template <class In, class Out>
static Out copy(In from, In to, Out into) {
    while (from != to) {
        *into = *from;
        ++into;
        ++from;
    }
    return into;
}

// **Written with an `if` and not a conditional**, and the reason is a compiler
// limit worth recording rather than working around silently: `return b < a ? b
// : a;` over two `const T &` is an lvalue and should be returnable as a
// reference, and this compiler reads the conditional as a temporary and refuses
// it. The two forms say the same thing; this one compiles.
template <class T>
static const T &min(const T &a, const T &b) {
    if (b < a) return b;
    return a;
}

template <class T>
static const T &max(const T &a, const T &b) {
    if (a < b) return b;
    return a;
}

template <class In, class T>
static In find(In from, In to, const T &want) {
    while (from != to && !(*from == want)) ++from;
    return from;
}

template <class In, class T>
static std::size_t count(In from, In to, const T &want) {
    std::size_t seen = 0;
    while (from != to) {
        if (*from == want) seen++;
        ++from;
    }
    return seen;
}


// **sort - [alg.sort], as an insertion sort.** The standard asks for O(n log n)
// and this is quadratic: a complexity guarantee this library does not meet,
// rather than a wrong answer, and it is written down here rather than implied.
// It needs no scratch memory and moves through the iterator alone, so it works
// for any iterator that can step both ways.
template <class It, class Less>
static void sort(It from, It to, Less less) {
    for (It i = from; i != to; ++i)
        for (It j = i; j != from; ) {
            It prev = j;
            --prev;
            if (!less(*j, *prev)) break;
            auto held = *prev;
            *prev = *j;
            *j = held;
            j = prev;
        }
}

// The same, ordered by `<` - which is what the two-argument form means.
template <class It>
static void sort(It from, It to) {
    for (It i = from; i != to; ++i)
        for (It j = i; j != from; ) {
            It prev = j;
            --prev;
            if (!(*j < *prev)) break;
            auto held = *prev;
            *prev = *j;
            *j = held;
            j = prev;
        }
}

}  // namespace std

#endif

// **reverse - [alg.reverse].** Swaps from both ends until they meet; the
// element type is deduced from a pointer to one, this header having no
// iterator_traits.
template <class It, class T>
static void reverseSwap(It a, It b, T *) {
    T held(*a);
    *a = *b;
    *b = held;
}

template <class It>
static void reverse(It from, It to) {
    while (from != to) {
        --to;
        if (from == to) break;
        reverseSwap(from, to, &*from);
        ++from;
    }
}

// **max_element and min_element - [alg.min.max].** The first iterator whose
// element no other beats, which is what makes them stable: `<` is asked in the
// order the standard fixes, so an earlier equal element wins for max_element
// and for min_element alike. `to` is returned for an empty range.
template <class It>
static It max_element(It from, It to) {
    if (from == to) return to;
    It best = from;
    for (It i = from; i != to; ++i)
        if (*best < *i) best = i;
    return best;
}

// The same, ordered by a comparison the caller writes.
template <class It, class Less>
static It max_element(It from, It to, Less less) {
    if (from == to) return to;
    It best = from;
    for (It i = from; i != to; ++i)
        if (less(*best, *i)) best = i;
    return best;
}

template <class It>
static It min_element(It from, It to) {
    if (from == to) return to;
    It best = from;
    for (It i = from; i != to; ++i)
        if (*i < *best) best = i;
    return best;
}

template <class It, class Less>
static It min_element(It from, It to, Less less) {
    if (from == to) return to;
    It best = from;
    for (It i = from; i != to; ++i)
        if (less(*i, *best)) best = i;
    return best;
}
