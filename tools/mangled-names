#!/bin/sh
# Put the linkage names cxx1 gives a file beside the ones clang gives it, for
# all three targets.
#
# Conforming to the platform ABI is only worth anything if it is checked, and
# this is what checks it: clang can be asked for either ABI on any machine -
# '-target x86_64-pc-windows-msvc' spells Microsoft names on a Mac - so the
# oracle for a name needs no Windows box and no linker.
#
#   tools/mangled-names case.cpp
#
# It compares the set of mangled names in the two assembly files. A name only
# one of them mentions is printed with < for cxx1 and > for clang.
set -u

ROOT=$(cd "$(dirname "$0")/.." && pwd)
# The compiler under test: named by CXX1 when the binary was built elsewhere
# (a BINDIR build), else the one beside this tree. Relative names are made
# absolute here because the calls below happen after a cd.
CXX1="${CXX1:-$ROOT/cpp11.exe}"
case "$CXX1" in /*) ;; *) CXX1="$(pwd)/$CXX1" ;; esac
SRC=$1
OUT=$(mktemp -d)
trap 'rm -rf "$OUT"' EXIT

# Only the places a symbol is really named: what the file exports and
# imports, what it defines, and what it calls. Reading every mangled-looking
# token instead sweeps up each compiler's names for its own labels and calls
# them disagreements.
#
# A name only one side has is not always a disagreement about spelling: a
# const that clang folded away has no symbol at all there, and cxx1 still
# gives it storage. Read the output rather than counting it.
#
# clang gives a string literal a mangled name of its own on Windows -
# ??_C@... - and merges it across translation units. cxx1 gives it a local
# label. That is a difference in how a literal is stored rather than in how a
# name is spelled, so it is left out here.
#
# **Only that one, though.** The exclusion used to be every name beginning
# `??`, which is every constructor, destructor, `operator=`, deleting
# destructor and function template specialization the Microsoft ABI spells -
# so none of them was ever compared here. Narrowed to ??_C@ when function
# templates arrived and the tool answered "0 names" for a file full of them.
#
# `GCC_except_table...` is excluded for a different reason: it labels a block
# of data inside the file rather than naming anything a linker resolves. It
# has to be a real symbol rather than an `L` temporary so that Mach-O's
# subsections_via_symbols cuts the section there - which is why it shows up
# here at all - and cxx1 and clang have no reason to spell it alike.
#
# `__clang_call_terminate` and the `_ZSt9terminatev` it calls are excluded for
# a third reason, and it is a real gap rather than a spelling: they are the
# guard clang emits for a destructor that throws while an exception is already
# unwinding. cxx1 emits no such guard - `noexcept` is not implemented and a
# destructor that throws during unwinding would simply escape - so the two
# names are a feature difference, recorded here rather than argued with on
# every case that has a destructor.
#
# **An indirect call names no symbol**, so the two `call` rules below skip an
# operand starting with '*'. Virtual dispatch is exactly that - `call *%r11` -
# and without the guard the register was scraped as a name and reported as a
# symbol cxx1 had and clang did not.
# **An EXTERN is a declaration, not a symbol this file has**, and reading one as
# a name made the comparison asymmetric the moment data started declaring its
# references. MASM needs every symbol a `DQ` names declared; the GNU spelling
# needs nothing, and the scrape has no rule for a `.quad` operand - so a vtable
# slot holding `_purecall` was a name on one side and absent on the other. Call
# targets are still compared, from the `call` lines, on both sides.
# **`OPTION PROC:PRIVATE` is not a function called OPTION.** The PROC rule
# below reads `<name> PROC` as a definition, and MASM's own directives are
# written the same shape - so the preamble that stops MASM exporting every
# PROC was scraped as a symbol and reported as a difference in all 78 cases.
# Directives are dropped before anything else looks at the line.
names() {
    grep -vE '^[[:space:]]*OPTION[[:space:]]' "$1" > "$1.nodirective"
    set -- "$1.nodirective"
    sed -n \
        -e 's/^[[:space:]]*\.globl[[:space:]]*//p' \
        -e 's/^[[:space:]]*PUBLIC[[:space:]]*//p' \
        -e 's/^\([^[:space:]]*\)[[:space:]][[:space:]]*PROC.*/\1/p' \
        -e 's/^\([^[:space:]:]*\):.*/\1/p' \
        -e 's/^\([A-Za-z_$?][A-Za-z0-9_$?@]*\)[[:space:]][[:space:]]*D[BWDQ][[:space:]].*/\1/p' \
        -e 's/^[[:space:]]*\.l\{0,1\}comm[[:space:]][[:space:]]*//p' \
        -e 's/^[[:space:]]*call[[:space:]][[:space:]]*\([^*][^[:space:]]*\).*/\1/p' \
        -e 's/^[[:space:]]*callq[[:space:]][[:space:]]*\([^*][^[:space:]]*\).*/\1/p' \
        -e 's/^[[:space:]]*bl[[:space:]][[:space:]]*//p' "$1" |
    sed -e 's/"//g' -e 's/[:,].*//' -e 's/@PLT$//' -e 's/[[:space:]].*//' |
    grep -vE '^$|^[.$]|^_*L|^l_|^@feat|^\?\?_C@|^GCC_except_table|^_*__clang_call_terminate$|^_*_ZSt9terminatev$|_end_|_begin_|^_*main$' |
    grep -vE '^_*stack_chk|^_*fltused$|^__real@|^__xmm@' |
    # MASM writes an indirect call as `call r11`, with no '*' to tell it from a
    # symbol - so the register names go here. The AT&T targets are handled by
    # the '*' guard above; this is the same exclusion for a syntax that offers
    # no marker.
    grep -vE '^r[0-9]+[dwb]?$|^[re]?[abcd]x$|^[re]?[sd]i$|^[re]?[sb]p$|^x[0-9]+$' |
    # **The Microsoft ABI's exception internals, dropped from both sides.**
    # A handler and a cleanup are compiled into funclets on that target, and
    # both compilers name them - `main$catch$0` here, `?dtor$2@?0?main@4HA`
    # from cl - but they are *file-local* symbols that nothing links against,
    # so a difference between the two spellings is not a difference in the
    # ABI. What this suite is for is the names that cross an object boundary,
    # and comparing these would report a naming style as a fault while adding
    # nothing: whether the handlers work is what catch-check and the run suite
    # answer. The personality routine and the terminate helper go with them -
    # which of those a compiler references is its own business.
    grep -vE 'catch\$|dtor\$|^_*__CxxFrameHandler|^_*__std_terminate$|^_*__GSHandlerCheck' |
    # **The initialiser functions are file-local too.** clang builds one
    # `__cxx_global_var_init.N` - `??__E...` on Windows - per object and one
    # `_GLOBAL__sub_I_<file>` calling them; cxx1 builds the sub function alone,
    # and MASM spells its dot as `$..._cpp`. Nothing links against any of them.
    # The `??__F` atexit helpers *are* compared: the same rule names them on
    # both sides, and a mistake there would be a naming fault.
    grep -vE '^_*__cxx_global_var_init|^\?\?__E|^\$?_+GLOBAL__sub_I_' |
    sort -u
}

status=0
for pair in "x86_64-linux:x86_64-linux-gnu" \
            "x86_64-windows:x86_64-pc-windows-msvc" \
            "arm64-darwin:arm64-apple-macos"; do
    mine=${pair%%:*}
    theirs=${pair#*:}

    # The same <case>.notarget tests/emit.sh reads: a case may name a target it
    # does not compile for yet, with the reason on the line. Printed every run,
    # because an exclusion nobody sees is an exclusion nobody removes.
    # Two different claims, two different files. **.notarget** says cxx1
    # cannot compile this case for that target at all - emit.sh reads it too.
    # **.nonames** says it compiles fine and only the symbol lists differ for a
    # recorded reason, so the emission stays covered and just this comparison
    # steps aside. Using the first for the second would quietly stop compiling
    # a case that compiles.
    for excuse in "${SRC%.cpp}.notarget" "${SRC%.cpp}.nonames"; do
        [ -f "$excuse" ] || continue
        grep -q "^$mine\b" "$excuse" || continue
        echo "$mine: skipped - $(grep "^$mine\b" "$excuse" | sed "s/^$mine[[:space:]]*//")"
        skip=yes
    done
    if [ "${skip:-}" = yes ]; then skip=; continue; fi

    if ! "$CXX1" -S -arch "$mine" "$SRC" -o "$OUT/mine.s" 2>"$OUT/mine.err"; then
        echo "$mine: cxx1 refused it"
        sed 's/^/    /' "$OUT/mine.err" | head -3
        status=1
        continue
    fi
    # **-fexceptions, and that was the other way round until rung 6.4.**
    # It used to be -fno-exceptions: a class with a destructor made clang emit
    # a cleanup path - the personality routine, .gcc_except_table,
    # _Unwind_Resume - and cxx1 had none of that, so the symbols read as a
    # disagreement about names when they were a difference in features.
    #
    # cxx1 emits those cleanups now, so the flag would hide *its* work
    # instead. Asking both compilers for the same language is the only
    # comparison worth making, and it is the one that would have caught a
    # missing cleanup rather than excusing it.
    #
    # **Windows is still asked with them off**, and that is not an oversight:
    # cxx1 makes no cleanup regions for that target - rung 6.5 - so asking
    # clang for MSVC's EH funclets there would compare a feature cxx1 has
    # against one it does not.
    #
    # **RTTI is asked for on the Itanium targets now, and that is the same
    # argument a third time.** It used to be -fno-rtti everywhere, because a
    # polymorphic class makes clang emit _ZTI and _ZTS and cxx1 emitted
    # neither, writing a plain 0 in the vtable's typeinfo slot. cxx1 emits both
    # since `dynamic_cast` landed, on all three targets - Itanium's two objects
    # behind the vtable and the Microsoft ABI's five in front of it alike - so
    # the two are comparable and are compared. That is what caught the tag
    # `__unnamed`, and what caught `??_R2Leaf@@@` for `??_R2Leaf@@8`.
    # **-fexceptions everywhere, since rung 6.5b step 4.** This asked clang for
    # -fno-exceptions on Windows while cxx1 had no exception tables for that
    # target: every case with a `throw` or a destructor would otherwise have
    # reported a missing feature as a naming difference. cxx1 throws, catches
    # and runs cleanups there now, so the two are comparable and are compared.
    EH=-fexceptions
    RTTI=-frtti
    if ! clang++ -x c++ -std=c++11 $EH $RTTI -w -target "$theirs" -S "$SRC" -o "$OUT/theirs.s" \
                 2>"$OUT/theirs.err"; then
        echo "$mine: clang refused it, so there is nothing to compare against"
        sed 's/^/    /' "$OUT/theirs.err" | head -3
        status=1
        continue
    fi

    names "$OUT/mine.s"   > "$OUT/mine.names"
    names "$OUT/theirs.s" > "$OUT/theirs.names"
    if diff "$OUT/mine.names" "$OUT/theirs.names" > "$OUT/diff" ; then
        echo "$mine: $(wc -l < "$OUT/mine.names" | tr -d ' ') names, all agreeing with clang"
    else
        echo "$mine: they differ - < cxx1, > clang"
        grep -E '^[<>]' "$OUT/diff" | sed 's/^/    /'
        status=1
    fi
done
exit $status
