#!/bin/sh
# Build and test this tree on all three machines, from the Mac.
#
# The standing rule in CLAUDE.md is that a change is not done until the Mac,
# the Linux box and the Windows box have all passed. This is that rule with a
# command behind it - it relays the working tree rather than a commit, so it
# can be run before committing, which is the order the rule wants.
#
#   tools/verify-three              both boxes
#   tools/verify-three linux        one of them
#   tools/verify-three windows
#
# It ships the tree as a tar rather than pulling a commit: the Windows box has
# no git, and on the Linux box a pull would test what was pushed instead of
# what is here.
set -u
ROOT=$(cd "$(dirname "$0")/.." && pwd)
WHICH=${1:-all}
KEY=${CXX1_LINUX_KEY:-$HOME/Documents/Claude/myMorningWalk.pem}
LINUX=${CXX1_LINUX:-ec2-user@52.202.164.123}
WINDOWS=${CXX1_WINDOWS:-windows}
TAR=$(mktemp -t cxx1src).tgz
STATUS=0

# The tree, minus everything a build makes. `winout` and the out-* directories
# are outputs of a previous run on the other side and shipping them back would
# compare a run against itself.
# **COPYFILE_DISABLE, and it is not optional.** Without it macOS bsdtar writes
# an AppleDouble `._Driver.cpp` beside every file that carries an extended
# attribute, `--no-xattrs` does not stop it, and `src\*.cpp` in msvc\build.cmd
# then hands those to cl - which reports `unknown character '0x5'` in a file
# nobody wrote. Same shape as the duplicate-file trap the Makefiles guard
# against with a $(wildcard) filter.
#
# **And that same duplicate trap, excluded here rather than swept.** iCloud
# Drive copies a file it is syncing to `name 2.ext`, and it does so whenever it
# likes - a sweep before the tar is not enough, because the copies reappear
# between the sweep and the tar. Shipped, `tests/cases/foo 2.cpp` is a case with
# no `.expected` of its own name and the far side reports it as "did not run":
# a red run that says nothing about the compiler. One three-box round was spent
# on exactly that.
# **The release material travels too**, and it is on this line rather than in a
# comment somewhere: `examples/` so the four Makefiles can be run on the machine
# each is written for, `README.1ST` because it is what a user is handed, and the
# seal so `tools/seal check` answers the same question on all three boxes. None
# of it changes what is built; all of it is part of what is released.
COPYFILE_DISABLE=1 tar -C "$ROOT" --no-xattrs -czf "$TAR" \
    --exclude .git --exclude obj --exclude obj-msvc --exclude winout \
    --exclude 'tests/out-*' --exclude '*.exe' --exclude .DS_Store \
    --exclude '* [0-9]' --exclude '* [0-9].*' \
    src tests lib include tools docs msvc ide examples \
    Makefile CLAUDE.md README.md README.1ST cxx1-1.2.dat cxx1.sln build \
    2>/dev/null

# **The Linux build goes through `./build`, which caps it.** That script runs
# make inside a 300 MB cgroup scope and says so plainly when no cgroup is
# available, and it exists because an unbounded job once drove this 419 MiB
# instance into swap until sshd could not fork. It sat unused for weeks while
# this script ran a bare `make -j4` on the same box - a safety net nobody was
# under - and on 2026-08-30 the box thrashed for exactly that reason: a killed
# run left its `make` orphaned on the far side, a second run overlapped it, and
# eight cc1plus competed for 419 MB with zram at 100%. Under the cap the
# runaway is killed alone and the box stays up.
#
# **-j2 and not -j4**, and the arithmetic is worth keeping: one cc1plus on the
# big parser files peaks near 50 MB, so two fit inside 300 MB with room, and
# four sit at the cap's edge where a legitimate build would be killed and
# reported as a verification failure. Raise it deliberately, having measured,
# or not at all.
#
# Killing this script does not stop the far side: the ssh closes and the build
# runs on as an orphan. Clear it before starting another -
# `ssh ... 'pkill -9 -x cc1plus; pkill -9 -x make'`.
if [ "$WHICH" = all ] || [ "$WHICH" = linux ]; then
    echo "=== linux ($LINUX) ==="
    scp -q -i "$KEY" -o BatchMode=yes "$TAR" "$LINUX:/tmp/cxx1src.tgz" || STATUS=1
    ssh -i "$KEY" -o BatchMode=yes "$LINUX" '
        rm -rf ~/cxx1-verify && mkdir -p ~/cxx1-verify &&
        tar -C ~/cxx1-verify -xzf /tmp/cxx1src.tgz &&
        cd ~/cxx1-verify && ./build -j2 >/dev/null && make test' || STATUS=1
fi

if [ "$WHICH" = all ] || [ "$WHICH" = windows ]; then
    echo "=== windows ($WINDOWS) ==="
    # **A directory of its own, and not a corner of somebody's scratch.** This
    # unpacked into C:\Users\GRA\source, which holds four other projects and a
    # drift of loose .exe, .obj and .pdb from hand-run experiments; C:\work is
    # the same kind of place. A verification sandbox sharing a junk drawer is
    # one stray `del` from a run that fails for no reason anybody can see, and
    # it makes `rmdir /s /q` on the sandbox a heavier thing to write than it
    # should be. C:\cxx1 belongs to this compiler and nothing else, so the
    # wipe-and-unpack below is safe to read at a glance.
    REMOTE='C:\cxx1\verify'
    scp -q -o BatchMode=yes "$TAR" "$WINDOWS:C:\\cxx1\\src.tgz" || STATUS=1
    # Windows ships its own tar. Extracting over a previous run rather than
    # into a clean directory is what leaves a stale object linking perfectly,
    # so the directory goes first.
    ssh -o BatchMode=yes "$WINDOWS" "rmdir /s /q $REMOTE 2>nul & mkdir $REMOTE && tar -C $REMOTE -xzf C:\\cxx1\\src.tgz" >/dev/null || STATUS=1
    ssh -o BatchMode=yes "$WINDOWS" "$REMOTE\\tools\\windows\\run-cases.cmd $REMOTE" || STATUS=1
    # The two-half programs, linked across the boundary with cl both ways:
    # the ABI at the seam, which nothing compiled by cxx1 alone can see.
    ssh -o BatchMode=yes "$WINDOWS" "$REMOTE\\tools\\windows\\winlink-check.cmd $REMOTE" || STATUS=1

    # The comparison happens here, not there - see run-cases.cmd for why.
    OUT=$(mktemp -d)
    # Forward slashes: scp's remote path goes through the shell, which eats
    # the backslashes, and the copy then silently finds nothing.
    scp -q -r -o BatchMode=yes "$WINDOWS:C:/cxx1/verify/winout" "$OUT"
    pass=0; fail=0
    for e in "$ROOT"/tests/cases/*.expected; do
        n=$(basename "$e" .expected)
        # **Excluded coming back as well as going out.** The tar above drops
        # the `name 2.ext` copies iCloud leaves, so the far side never sees
        # them - but this loop reads the local directory, where they are, and
        # then reports each as "did not run" against output that was rightly
        # never produced. 125 of them on 2026-09-08, every one a copy, and the
        # run exited 1 for a reason that had nothing to do with the compiler.
        case "$n" in *" "[0-9]*) continue;; esac
        nt="$ROOT/tests/cases/$n.notarget"
        if [ -f "$nt" ] && grep -q x86_64-windows "$nt"; then
            echo "  skip $n: $(grep x86_64-windows "$nt")"
            continue
        fi
        got="$OUT/winout/$n.out"
        if [ ! -f "$got" ]; then
            echo "  $n: did not run"; fail=$((fail + 1)); continue
        fi
        if tr -d '\r' < "$got" | diff -q - "$e" >/dev/null; then
            pass=$((pass + 1))
        else
            echo "  $n: output differs"
            tr -d '\r' < "$got" | diff - "$e" | head -6
            fail=$((fail + 1))
        fi
    done
    # The refusals. What is checked is the same thing tests/run.sh checks -
    # that the compiler stopped, and that its message contains the recorded
    # text - because a refusal that stops for the wrong reason is not the one
    # the case is about.
    for e in "$ROOT"/tests/winlink/*.expected; do
        [ -f "$e" ] || continue
        n=$(basename "$e" .expected)
        case "$n" in *" "[0-9]*) continue;; esac
        for way in ab ba; do
            got="$OUT/winout/winlink-$n-$way.out"
            if [ ! -f "$got" ]; then
                echo "  winlink $n ($way): did not run"; fail=$((fail + 1)); continue
            fi
            if tr -d '\r' < "$got" | cmp -s - "$e"; then
                pass=$((pass + 1))
            else
                echo "  winlink $n ($way): output differs"
                tr -d '\r' < "$got" | diff - "$e" | head -6
                fail=$((fail + 1))
            fi
        done
    done
    for e in "$ROOT"/tests/cases/*.error; do
        n=$(basename "$e" .error)
        case "$n" in *" "[0-9]*) continue;; esac   # the copies again
        nt="$ROOT/tests/cases/$n.notarget"
        if [ -f "$nt" ] && grep -q x86_64-windows "$nt"; then
            echo "  skip $n: $(grep x86_64-windows "$nt")"
            continue
        fi
        got="$OUT/winout/$n.err"
        if [ ! -f "$got" ]; then
            echo "  $n: did not run"; fail=$((fail + 1)); continue
        fi
        if tr -d '\r' < "$got" | grep -qF "$(cat "$e")"; then
            pass=$((pass + 1))
        else
            echo "  $n: wanted \"$(cat "$e")\", got:"
            tr -d '\r' < "$got" | sed 's/^/      /' | head -4
            fail=$((fail + 1))
        fi
    done
    # The Windows half of tools/unwind-check: something cxx1 threw, caught by
    # cl. A run rather than a diff, for the same reason.
    if ssh -o BatchMode=yes "$WINDOWS" "$REMOTE\\tools\\windows\\throw-check.cmd $REMOTE" \
           > "$OUT/throw.txt" 2>&1 &&
       [ "$(tr -d '\r' < "$OUT/throw.txt" | tail -2)" = "int 7
double 2.5" ]; then
        echo "  throw-check: a cxx1 throw was caught by cl"
    else
        echo "  throw-check: FAILED"
        tail -4 "$OUT/throw.txt" | sed 's/^/      /'
        fail=$((fail + 1))
    fi

    # **A cl caller against a cxx1 callee**, which is the one question a
    # same-compiler test cannot ask: cxx1 passed the hidden return pointer and
    # `this` in the opposite registers from cl, on both sides of every call it
    # generated, so every run.sh case agreed with itself and disagreed with
    # the platform. The fourth number is the small struct, which asks the
    # other half of the member rule: the hidden pointer serves a member's
    # return whatever its size, where cxx1 once kept the free-function size
    # test and answered in eax. 17 20 7 19 is what cl's caller reads back.
    if ssh -o BatchMode=yes "$WINDOWS" "$REMOTE\\tools\\windows\\sret-check.cmd $REMOTE" \
           2>/dev/null | tr -d '\r' | grep -q '^17 20 7 19$'; then
        echo "  sret-check: cl called a cxx1 member and got its struct back"
    else
        echo "  sret-check: FAILED"
        STATUS=1
    fi

    # The mirror, and the one rung 6.5b is for: both halves compiled by cxx1,
    # so what it tests is the funclet and the FH3 tables rather than the
    # ThrowInfo chain the check above covers.
    if ssh -o BatchMode=yes "$WINDOWS" "$REMOTE\\tools\\windows\\catch-check.cmd $REMOTE" \
           2>/dev/null | tr -d '\r' | grep -q '^caught 7$'; then
        echo "  catch-check: cxx1 caught what cxx1 threw"
    else
        echo "  catch-check: FAILED"
        STATUS=1
    fi
    echo "windows cases: $pass passed, $fail failed"

    # **The names, asked of cl rather than of clang.** tests/names.sh compares
    # against clang with -target x86_64-pc-windows-msvc, which is a second
    # implementation of the Microsoft ABI; this asks the ABI itself, on the box
    # where it lives. The first run of it found that every `static` function
    # came out of the object as an External symbol - MASM exports every PROC
    # unless told not to - which no name comparison could see, because the
    # names were right and it was the storage class beside them that was wrong.
    #
    # Compared here and not there for the reason run-cases.cmd gives about its
    # own output: cmd is a poor place to cut up text, and this box has no awk.
    # Defined external symbols. cl's float and string literal COMDATs are
    # dropped: it names those and cxx1 puts them in .rdata unnamed, which is a
    # codegen difference and says nothing about a symbol anybody links.
    clsyms() {
        grep -E "SECT[0-9A-F]+ .*External" "$1" 2>/dev/null |
        sed -e 's/.*| //' -e 's/ (.*//' -e 's/[[:space:]]*$//' |
        grep -vE '^__real@|^__xmm@|^\?\?_C@' | sort -u
    }
    ssh -o BatchMode=yes "$WINDOWS" "$REMOTE\\tools\\windows\\names-vs-cl.cmd $REMOTE" >/dev/null || STATUS=1
    NOUT=$(mktemp -d)
    scp -q -r -o BatchMode=yes "$WINDOWS:C:/cxx1/verify/winnames" "$NOUT" 2>/dev/null
    nagree=0; ndiffer=0
    for mine in "$NOUT"/winnames/*.mine.txt; do
        [ -f "$mine" ] || continue
        n=$(basename "$mine" .mine.txt)
        theirs="$NOUT/winnames/$n.cl.txt"
        [ -f "$theirs" ] || continue
        # Temp files and not process substitution: this script is /bin/sh.
        clsyms "$mine"   > "$NOUT/a.$$"
        clsyms "$theirs" > "$NOUT/b.$$"
        if cmp -s "$NOUT/a.$$" "$NOUT/b.$$"; then
            nagree=$((nagree + 1))
        else
            echo "  NAMES-DIFFER $n - < cxx1, > cl"
            diff "$NOUT/a.$$" "$NOUT/b.$$" | grep -E '^[<>]' | sed 's/^/      /'
            ndiffer=$((ndiffer + 1))
            STATUS=1
        fi
    done
    # What was not compared, by kind. A .nocl records a difference against cl
    # and its first sentence is printed for the reason a .notarget's is: an
    # exclusion nobody sees is an exclusion nobody removes.
    nnocl=0; nnotarget=0; nrefused=0; nclrefused=0
    for k in "$NOUT"/winnames/*.skip; do
        [ -f "$k" ] || continue
        n=$(basename "$k" .skip)
        kind=$(tr -d '\r\n' < "$k")
        if [ -f "$ROOT/tests/cases/$n.nocl" ]; then
            nnocl=$((nnocl + 1))
            echo "  nocl $n: $(tr '\n' ' ' < "$ROOT/tests/cases/$n.nocl" | tr -s ' ' | cut -c1-96)"
        elif [ "$kind" = cxx1-refused ]; then
            # No exclusion file covers this one, so it is a case that quietly
            # left the comparison. run-cases.cmd owns the verdict; this names it.
            nrefused=$((nrefused + 1))
            echo "  cxx1 refused $n - not compared, and no exclusion file says so"
        elif [ "$kind" = cl-refused ]; then
            nclrefused=$((nclrefused + 1))
        else
            nnotarget=$((nnotarget + 1))
        fi
    done
    nskip=$((nnocl + nnotarget + nrefused + nclrefused))
    rm -rf "$NOUT"
    echo "windows names vs cl: $nagree agreed, $ndiffer differed, $nskip skipped" \
         "($nnocl recorded, $nnotarget not for this target," \
         "$nrefused cxx1-refused, $nclrefused cl-refused)"
    [ "$fail" -eq 0 ] || STATUS=1
    rm -rf "$OUT"
fi

rm -f "$TAR"
exit $STATUS
