# examples\Makefile.windows - this project, built for Windows on x86-64.
#
# ©2026 G. R. Akhtar - ISO C++ 11
#
# **This one is for NMAKE**, which ships with Visual Studio, and its syntax is
# not GNU make's: inference rules are written `.cpp.obj:`, there is no
# `$(wildcard)`, and the sources are therefore listed. Run it from a Developer
# Command Prompt, or from any shell that has run vcvars64.bat - `ml64` and
# `link` reach PATH only there, and cxx1 runs both.
#
#   nmake /f Makefile.windows            build demo.exe
#   nmake /f Makefile.windows run
#   nmake /f Makefile.windows asm        the assembly, to read
#   nmake /f Makefile.windows clean
#
# GNU make on Windows works too - use the portable Makefile beside this one and
# say OBJS with .obj if you prefer that suffix; cxx1 takes either.

# One object per source, as the other three Makefiles do. **That works here
# because the default assembly spelling for this target is the GNU one**, which
# clang assembles and which can mark a definition COMDAT; ml64's cannot, so
# `-masm=masm` still needs the unity build unity.cpp holds.
TARGET    = demo.exe
SRCS      = demo.cpp report.cpp shapes.cpp
OBJS      = demo.obj report.obj shapes.obj
ASMS      = demo.s report.s shapes.s

CXX1      = cxx1.exe
CXX1FLAGS =

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CXX1) $(CXX1FLAGS) $(OBJS) -o $(TARGET)

.cpp.obj:
	$(CXX1) $(CXX1FLAGS) -c $< -o $@

run: $(TARGET)
	.\$(TARGET)

# **`-masm=masm` is the other spelling**, ml64's, for a machine with no clang.
# It cannot mark a definition COMDAT, so a program built that way has to be one
# translation unit - `nmake /f Makefile.windows CXX1FLAGS=-masm=masm` on
# unity.cpp is that build. Neither spelling changes what the program does.
asm:
	$(CXX1) $(CXX1FLAGS) -S -arch x86_64-windows demo.cpp -o demo.s
	$(CXX1) $(CXX1FLAGS) -S -arch x86_64-windows report.cpp -o report.s
	$(CXX1) $(CXX1FLAGS) -S -arch x86_64-windows shapes.cpp -o shapes.s

clean:
	-del /q $(TARGET) $(OBJS) $(ASMS) 2>nul
